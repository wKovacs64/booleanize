{
  "name": "@wkovacs64/booleanize",
  "version": "3.0.1",
  "private": false,
  "description": "Small utility to coerce a value to its boolean equivalent",
  "bugs": {
    "url": "https://github.com/wKovacs64/booleanize/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Justin Hall",
    "email": "justin.r.hall@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wKovacs64/booleanize.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "del-cli dist && tsc --project tsconfig.build.json",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install",
    "changeset:publish": "changeset publish",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepare": "pnpm run --silent build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "@wkovacs64/eslint-config": "8.0.3",
    "@wkovacs64/oxlint-config": "0.1.0",
    "del-cli": "7.0.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0"
}
